# Dependencies (reinstalled in deps stage)
node_modules

# Build output (produced inside container)
.next
.git

# Secrets — never bake into image
.env
.env.*
*.env

# Tests — not needed at runtime
tests/
coverage/
playwright-report/
test-results/
tests/e2e/test-results
tests/e2e/playwright-report

# Dev tooling config — not needed at runtime
playwright.config.ts
vitest.config.ts
eslint.config.mjs
.prettierrc.json
.prettierignore
tsconfig.tsbuildinfo

# IDE / OS noise
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# Docs (not needed in image)
README.md
CLAUDE.md
LICENSE
docs/

# Logs
*.log
logs/
