# Database
# edict_app — RLS-enforced role for per-tenant queries.
# edict_admin_role — BYPASSRLS role for admin UI, migrations, audit writes.
#   Created by migrations/0002_rls.sql. Narrower than the postgres superuser.
DATABASE_URL=postgres://edict_app:dev@127.0.0.1:5432/edict
DATABASE_ADMIN_URL=postgres://edict_admin_role:dev@127.0.0.1:5432/edict

# App
APP_URL=http://localhost:3000
SESSION_COOKIE_NAME=edict_session

# Mail
RESEND_API_KEY=re_replace_me
RESEND_FROM=edict@rectorspace.com

# Admin bootstrap
ADMIN_BOOTSTRAP_EMAIL=rector@rectorspace.com

# Dev-only flag
DEV_PRINT_MAGIC_LINKS=true
