# This file is the LOCAL DEV template — copy to `.env` and fill in.
# Production values live in the Vercel project env, NOT here. In production
# DATABASE_URL / DATABASE_ADMIN_URL are Neon Postgres connection strings; the
# `lib/db` driver auto-selects @neondatabase/serverless for *.neon.tech hosts
# and node-postgres for local/CI.

# Database (local dev)
# edict_app — RLS-enforced role for per-tenant queries. Created by migrations/0002_rls.sql.
# edict_admin — local Postgres superuser used for migrations
#   (drizzle-kit migrate needs SUPERUSER to run 0002_rls.sql's CREATE ROLE statements)
#   AND runtime admin queries. In local dev the superuser password is "dev".
#   (Note: migrations/0002_rls.sql also creates a narrower edict_admin_role with
#   BYPASSRLS. It is unused today due to the migration chicken-and-egg. See
#   docs/deployment-runbook.md §Database roles & migrations for the reroute plan.)
DATABASE_URL=postgres://edict_app:dev@127.0.0.1:5432/edict
DATABASE_ADMIN_URL=postgres://edict_admin:dev@127.0.0.1:5432/edict

# App
APP_URL=http://localhost:3000
SESSION_COOKIE_NAME=edict_session

# Mail
RESEND_API_KEY=re_replace_me
RESEND_FROM=edict@rectorspace.com

# Admin bootstrap
ADMIN_BOOTSTRAP_EMAIL=rector@rectorspace.com

# Dev-only flag
DEV_PRINT_MAGIC_LINKS=true
